# Alpaca API credentials (use PAPER keys unless going live)
ALPACA_API_KEY=your_key_here
ALPACA_API_SECRET=your_secret_here

# Master safety switch. When False, the bot is locked to the Alpaca
# paper-trading sandbox and no live orders can be sent. Only set to True
# with real-money keys when you explicitly want live execution.
LIVE_TRADING=False

# Comma-separated symbols to watch
WATCHLIST=SPY,QQQ,AAPL

# Strategy timeframe in hours
BAR_TIMEFRAME_HOURS=4

# Risk per trade as a fraction of account equity
RISK_PER_TRADE=0.01

# Risk engine: stop distance = ATR(20) x this multiple below entry
STOP_ATR_MULT=1.5
# Profit target distance as a multiple of the per-share risk
REWARD_RISK=2.5

# Logging
LOG_LEVEL=INFO
